# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=https://your-deploy.vercel.app

# SignalWire (calls + SMS)
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE_URL=
LAML_WEBHOOK_SECRET=

# Resend (transactional / brand-level outbound email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cron auth (Vercel Cron auto-injects this header; leaving unset opens routes)
CRON_SECRET=

# OAuth — per-user Google / Microsoft connections (calendar in Phase 1, email later)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
# HMAC secret for the OAuth `state` round-trip. Use any random 32+ char string.
OAUTH_STATE_SECRET=
# Defaults to NEXT_PUBLIC_APP_URL when unset.
OAUTH_REDIRECT_BASE=
